{
    "name": "aliro-mayday-software",
    "version": "0.1.0",
    "scripts": {
        "ng": "ng",
        "prestart": "node scripts/content-version.mjs",
        "start": "ng serve",
        "prebuild": "node scripts/content-version.mjs && node scripts/build-controller-demo.mjs",
        "build": "ng build",
        "prewatch": "node scripts/content-version.mjs",
        "watch": "ng build --watch --configuration development",
        "format": "prettier --write \"**/*.{js,mjs,ts,mts,d.ts,html,scss}\" --cache",
        "lint": "ng lint",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "demo:build": "node scripts/build-controller-demo.mjs"
    },
    "private": true,
    "dependencies": {
        "@angular/common": "^21",
        "@angular/compiler": "^21",
        "@angular/core": "^21",
        "@angular/forms": "^21",
        "@angular/platform-browser": "^21",
        "@angular/router": "^21",
        "@angular/service-worker": "^21.2.6",
        "@ngx-translate/core": "^17.0.0",
        "@ngx-translate/http-loader": "^17.0.0",
        "qrcode-generator": "^2.0.4",
        "rxjs": "~7.8.0",
        "tslib": "^2.8.1"
    },
    "devDependencies": {
        "@angular-devkit/build-angular": "^21",
        "@angular/cli": "^21",
        "@angular/compiler-cli": "^21",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.59.1",
        "angular-eslint": "21.3.1",
        "eslint": "^10.0.3",
        "prettier": "^3.0.0",
        "typescript": "~5.9.3",
        "typescript-eslint": "8.56.1"
    }
}
